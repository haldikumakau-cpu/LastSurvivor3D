var PT={cash:0xf2c94c,coin:0x4dd0e1,roti:0xe08a3a,air:0x4da6ff,perban:0xff5a5a,energi:0xb06bff,daging:0xc0643a};
var PL=['cash','cash','cash','coin','roti','roti','air','air','perban','energi','daging'];
var pgm={},pbm={};for(var pk in PT){pgm[pk]=new THREE.MeshBasicMaterial({color:PT[pk]});pbm[pk]=new THREE.MeshBasicMaterial({color:PT[pk],transparent:true,opacity:.3})}
var PK=[],og=new THREE.OctahedronGeometry(.3,0),bg=new THREE.CylinderGeometry(.04,.04,3,4);
function spot(p){var q=ring(0,0,4,125),t=PL[Math.floor(Math.random()*PL.length)];p.x=q[0];p.z=q[1];p.t=t;p.m.material=pgm[t];p.b.material=pbm[t];p.g.position.set(p.x,0,p.z)}
for(var pi=0;pi<28;pi++){var pg=new THREE.Group(),pm=new THREE.Mesh(og,pgm.cash),pb=new THREE.Mesh(bg,pbm.cash);pm.position.y=.8;pb.position.y=1.5;pg.add(pm,pb);sc.add(pg);var po={g:pg,m:pm,b:pb,x:0,z:0,t:'cash'};spot(po);PK.push(po)}

/* ===== MISI, XP, EFEK ===== */
function Q(i){var k=[['pick','Kumpulkan item'],['kill','Kalahkan zombie'],['use','Gunakan item']][i%3],n=3+i;return{k:k[0],t:k[1]+' x'+n,n:n,m:40+i*15,x:40+i*10,c:(i%3===1)?1:0}}
function qAdd(kind){var q=Q(S.q.i);if(q.k!==kind)return;S.q.p++;if(S.q.p>=q.n){S.money+=q.m;S.coins+=q.c;S.q.i++;S.q.p=0;toast('Misi selesai! +'+q.m+'💰'+(q.c?' +'+q.c+'🪙':'')+' +'+q.x+' XP');addXp(q.x)}save()}
function addXp(n){S.xp+=n;while(S.xp>=need()){S.xp-=need();S.level++;hp=maxHp();toast('Naik level! Lv '+S.level)}}
function hurt(n){hp-=n;var f=$('hf');f.style.opacity=1;setTimeout(function(){f.style.opacity=0},120);if(hp<=0&&mode==='play')die()}
function collect(p){var t=p.t;
  if(t==='cash'){var v=10+Math.floor(Math.random()*20);S.money+=v;toast('+'+v+' uang')}
  else if(t==='coin'){S.coins++;toast('+1 coin')}
  else{S.inv[t]=(S.inv[t]||0)+1;toast('Mendapat '+ITEMS[t].n)}
  addXp(3);qAdd('pick');spot(p);save()}
function kill(e){e.dead=true;e.o.g.visible=false;e.rt=9;var m=8+Math.floor(Math.random()*13);S.money+=m;addXp(18+S.level*2);
  var c=Math.random()<.25;if(c)S.coins++;toast('Zombie tumbang +'+m+'💰'+(c?' +1🪙':''));qAdd('kill');save()}
function act(){
  if(mode!=='play')return;
  if(atkCd<=0){
    var b=null,bd=2.9;
    EN.forEach(function(e){if(e.dead)return;var d=Math.hypot(e.x-P.x,e.z-P.z);if(d<bd){bd=d;b=e}});
    if(b){atkCd=.45;atkT=.3;b.hp-=dmgP();b.fl=.15;b.o.torso.material.emissive.setHex(0x8a0000);
      var d2=Math.hypot(b.x-P.x,b.z-P.z)||1;b.x+=(b.x-P.x)/d2;b.z+=(b.z-P.z)/d2;if(b.hp<=0)kill(b);return}
  }
  var bp=null,pd=3.4;
  PK.forEach(function(p){var d=Math.hypot(p.x-P.x,p.z-P.z);if(d<pd){pd=d;bp=p}});
  if(bp){collect(bp);return}
  if(atkCd<=0)toast('Tidak ada target di dekatmu')
}

/* ===== INPUT ===== */
var jx=0,jy=0,jid=-1,cid=-1,cx=0,cy=0,jbx=0,jby=0,K={w:0,a:0,s:0,d:0},jb=$('jb'),jk=$('jk');
function moveJoy(e){var dx=e.clientX-jbx,dy=e.clientY-jby,d=Math.hypot(dx,dy)||1,m=Math.min(d,50);jx=dx/d*m/50;jy=dy/d*m/50;jk.style.transform='translate('+(jx*40)+'px,'+(jy*40)+'px)'}
cv.addEventListener('pointerdown',function(e){
  if(mode!=='play')return;
  if(e.clientX<window.innerWidth*.45&&jid<0){jid=e.pointerId;jbx=e.clientX;jby=e.clientY;jb.style.left=(jbx-60)+'px';jb.style.top=(jby-60)+'px';moveJoy(e)}
  else if(cid<0){cid=e.pointerId;cx=e.clientX;cy=e.clientY}
});
window.addEventListener('pointermove',function(e){
  if(e.pointerId===jid)moveJoy(e);
  else if(e.pointerId===cid){cyaw-=(e.clientX-cx)*.006;cp=Math.max(.08,Math.min(1.1,cp+(e.clientY-cy)*.004));cx=e.clientX;cy=e.clientY}
});
function up(e){
  if(e.pointerId===jid){jid=-1;jx=jy=0;jk.style.transform='';jb.style.left='36px';jb.style.top='calc(100% - 160px)'}
  if(e.pointerId===cid)cid=-1;
}
window.addEventListener('pointerup',up);window.addEventListener('pointercancel',up);
function setRun(v){runOn=v;$('br').classList.toggle('on',v)}
$('bj').addEventListener('pointerdown',function(e){e.preventDefault();jumpReq=true});
$('ba').addEventListener('pointerdown',function(e){e.preventDefault();act()});
$('br').addEventListener('pointerdown',function(e){e.preventDefault();if(mode==='play')setRun(!runOn)});
$('bI').addEventListener('click',function(){if(mode==='play')inv()});
$('bS').addEventListener('click',function(){if(mode==='play')shop()});
$('bP').addEventListener('click',function(){pause()});
window.addEventListener('keydown',function(e){
  var c=e.code;if(c==='KeyW'||c==='ArrowUp')K.w=1;if(c==='KeyS'||c==='ArrowDown')K.s=1;if(c==='KeyA'||c==='ArrowLeft')K.a=1;if(c==='KeyD'||c==='ArrowRight')K.d=1;
  if(c==='Space')jumpReq=true;if(c==='KeyE')act();if(c==='ShiftLeft')setRun(!runOn);if(c==='Escape'){if(mode==='play')pause();else if(mode==='ui')resume()}
});
window.addEventListener('keyup',function(e){var c=e.code;if(c==='KeyW'||c==='ArrowUp')K.w=0;if(c==='KeyS'||c==='ArrowDown')K.s=0;if(c==='KeyA'||c==='ArrowLeft')K.a=0;if(c==='KeyD'||c==='ArrowRight')K.d=0});

/* ===== UPDATE GAMEPLAY ===== */
function updE(dt){
  var night=dayK<.35;
  for(var i=0;i<EN.length;i++){
    var e=EN[i];
    if(e.dead){e.rt-=dt;if(e.rt<=0)spawnE(e);continue}
    var dx=P.x-e.x,dz=P.z-e.z,d=Math.hypot(dx,dz)||.001,spd,tx,tz;
    if(d<(night?28:19)){tx=dx/d;tz=dz/d;spd=night?2.9:2.3}
    else{e.wt-=dt;if(e.wt<=0){e.wa=Math.random()*6.28;e.wt=2+Math.random()*3}tx=Math.sin(e.wa);tz=Math.cos(e.wa);spd=.7}
    if(d>1.1||spd<1){e.x+=tx*spd*dt;e.z+=tz*spd*dt}
    collide(e,.4);
    e.o.g.position.set(e.x,0,e.z);e.o.g.rotation.y=Math.atan2(tx,tz);
    e.ph+=dt*spd*3.5;var a=Math.sin(e.ph)*.5;
    e.o.lL.rotation.x=a;e.o.lR.rotation.x=-a;e.o.aL.rotation.x=-1.5+a*.2;e.o.aR.rotation.x=-1.5-a*.2;
    if(d<1.5){e.cd-=dt;if(e.cd<=0){e.cd=1.1;hurt(Math.max(1,Math.round((7+S.level*1.5)*(1-defP()/50))))}}else e.cd=Math.min(e.cd,.5);
    if(e.fl>0){e.fl-=dt;if(e.fl<=0)e.o.torso.material.emissive.setHex(0)}
  }
}
function play(dt){
  var ix=jx+(K.d-K.a),iy=jy+(K.s-K.w),m=Math.hypot(ix,iy);
  if(m>1){ix/=m;iy/=m;m=1}
  if(m<.15){m=0;ix=0;iy=0}
  var sn=Math.sin(cyaw),cs=Math.cos(cyaw),dx=ix*cs+iy*sn,dz=-ix*sn+iy*cs;
  var run=runOn&&en>1&&m>0,spd=(run?6.2:3.2)*m;
  P.x+=dx*spd*dt;P.z+=dz*spd*dt;
  if(m>0)pl.g.rotation.y=Math.atan2(dx,dz);
  collide(P,.4);
  if(run)en-=18*dt;else en=Math.min(maxEn(),en+(m>0?6:14)*dt);
  if(en<=0){en=0;setRun(false)}
  if(jumpReq&&P.y<=0){P.vy=7.2}
  jumpReq=false;P.vy-=20*dt;P.y+=P.vy*dt;if(P.y<=0){P.y=0;P.vy=0}
  hu=Math.max(0,hu-.3*dt);th=Math.max(0,th-.42*dt);
  if(hu<=0||th<=0)hurt(1.2*dt);else if(hu>50&&th>50&&hp<maxHp())hp=Math.min(maxHp(),hp+.9*dt);
  atkCd-=dt;
  ph+=dt*(run?13:8)*(m>0?1:0);
  var am=m>0?(run?.95:.6):0,sw=Math.sin(ph);
  if(P.y>.05){pl.aL.rotation.x=pl.aR.rotation.x=-2.5;pl.lL.rotation.x=-.5;pl.lR.rotation.x=.4}
  else{pl.lL.rotation.x=sw*am;pl.lR.rotation.x=-sw*am;pl.aL.rotation.x=-sw*am*.9;pl.aR.rotation.x=sw*am*.9}
  if(atkT>0){atkT-=dt;pl.aR.rotation.x=-2.3*Math.sin(Math.PI*(1-Math.max(0,atkT)/.3))}
  pl.g.position.set(P.x,P.y,P.z);
  updE(dt);
  for(var i=0;i<PK.length;i++){var p=PK[i];p.m.rotation.y+=dt*2;p.m.position.y=.8+Math.sin(ph*.3+i+dayT*200)*.15;
    if(Math.abs(p.x-P.x)<1.6&&Math.abs(p.z-P.z)<1.6&&Math.hypot(p.x-P.x,p.z-P.z)<1.6)collect(p)}
  cam.position.set(P.x+Math.sin(cyaw)*Math.cos(cp)*7,P.y*.5+1.6+Math.sin(cp)*7,P.z+Math.cos(cyaw)*Math.cos(cp)*7);
  cam.lookAt(P.x,P.y*.6+1.4,P.z);
}
var hT=0;
function hud(){
  $('bh').style.width=Math.max(0,hp/maxHp()*100)+'%';$('be').style.width=en/maxEn()*100+'%';
  $('bf').style.width=hu+'%';$('bw').style.width=th+'%';
  $('lv').textContent='Lv '+S.level;$('xb').style.width=S.xp/need()*100+'%';
  $('cash').textContent='💰 '+S.money+'   🪙 '+S.coins;
  var q=Q(S.q.i);$('qst').textContent='Misi: '+q.t+' ('+S.q.p+'/'+q.n+')';
}

/* ===== SIANG / MALAM ===== */
function env(cx,cz){
  var sh=Math.sin(dayT*6.2832);dayK=Math.max(0,Math.min(1,sh*1.6+.35));
  cSky.copy(cNight).lerp(cDay,dayK);
  var dus=Math.max(0,1-Math.abs(sh)*4);cSky.lerp(cDusk,dus*.4);
  sc.background=cSky;sc.fog.color.copy(cSky);sc.fog.density=.014+(1-dayK)*.008;
  hemi.intensity=.12+.5*dayK;sun.intensity=.06+.95*Math.max(0,sh);
  sun.position.set(cx+Math.cos(dayT*6.2832)*50,Math.max(10,sh*55),cz+30);sun.target.position.set(cx,0,cz);
  fl.position.set(cx,2.6,cz);fl.intensity=(1-dayK)*1.2;
  stars.position.set(cx,0,cz);stars.material.opacity=Math.max(0,1-dayK*2.2);
}

/* ===== UI PANEL ===== */
var shopTab='g',bk=null;
function ov(h){var e=$('ov');e.innerHTML=h;e.style.display='flex'}
function resume(){$('ov').style.display='none';mode='play';document.body.className='in'}
function initRun(){
  hp=maxHp();en=maxEn();hu=th=100;P.x=0;P.z=8;P.y=0;P.vy=0;cyaw=0;cp=.35;setRun(false);atkCd=0;atkT=0;
  EN.forEach(function(e){spawnE(e)});applyGear();hud();
}
function newGame(){S=newSave();initRun();save();resume()}
function cont(){var s=load();if(!s)return;S=s;initRun();resume()}
function menu(){
  mode='menu';document.body.className='';
  ov('<div class="pn" style="text-align:center"><div class="lg">LAST<br>SURVIVOR <b>3D</b></div><p class="mu">Jelajahi. Kumpulkan. Bertahan hidup.</p>'+
  '<button class="bt pr" onclick="newGame()">New Game</button>'+
  '<button class="bt" '+(load()?'':'disabled')+' onclick="cont()">Continue</button>'+
  '<button class="bt" onclick="bk=menu;settings()">Pengaturan</button></div>');
}
function pause(){
  if(mode!=='play')return;mode='ui';save();setRun(false);
  ov('<div class="pn"><div class="hd"><h2>Jeda</h2></div><button class="bt pr" onclick="resume()">Lanjutkan</button>'+
  '<button class="bt" onclick="bk=pause2;settings()">Pengaturan</button><button class="bt" onclick="menu()">Menu Utama</button></div>');
}
function pause2(){mode='play';pause()}
function settings(){
  ov('<div class="pn"><div class="hd"><h2>Pengaturan</h2></div>'+
  '<div class="row"><div class="gr">Bayangan</div><button class="bt sm" onclick="tog(\'shadow\')">'+(SET.shadow?'Hidup':'Mati')+'</button></div>'+
  '<div class="row"><div class="gr">Kualitas grafis<small>Hemat = lebih ringan</small></div><button class="bt sm" onclick="tog(\'hq\')">'+(SET.hq?'Tinggi':'Hemat')+'</button></div>'+
  '<div class="row"><div class="gr">Hapus data simpanan</div><button class="bt sm dg" onclick="wipe()">Hapus</button></div>'+
  '<button class="bt" onclick="bk()">Kembali</button></div>');
}
function tog(k){SET[k]=!SET[k];saveSet();applySet();settings()}
function wipe(){try{localStorage.removeItem(KEY)}catch(e){}toast('Data dihapus');menu()}
function inv(){
  mode='ui';setRun(false);var h='',c=0;
  for(var id in S.inv){var n=S.inv[id];if(n<=0)continue;c++;var it=ITEMS[id],eqd=SLOT[it.t]&&S.eq[it.t]===id;
    h+='<div class="row"><div class="gr"><b>'+it.n+' x'+n+(eqd?' ✔':'')+'</b><small>'+it.d+'</small></div><button class="bt sm pr" onclick="useIt(\''+id+'\')">'+(eqd?'Lepas':'Pakai')+'</button><button class="bt sm dg" onclick="delIt(\''+id+'\')">Hapus</button></div>'}
  if(!c)h='<p class="mu">Tas kosong. Kumpulkan item atau beli di toko.</p>';
  ov('<div class="pn"><div class="hd"><h2>Tas</h2><span>💰 '+S.money+' &nbsp;🪙 '+S.coins+'</span></div>'+h+'<button class="bt" onclick="resume()">Tutup</button></div>');
}
function useIt(id){
  var it=ITEMS[id];
  if(SLOT[it.t]){S.eq[it.t]=(S.eq[it.t]===id)?null:id;applyGear();toast(S.eq[it.t]?it.n+' dipakai':it.n+' dilepas')}
  else{
    S.inv[id]--;if(S.inv[id]<=0)delete S.inv[id];
    if(it.t==='med')hp=Math.min(maxHp(),hp+it.v);else if(it.t==='f')hu=Math.min(100,hu+it.v);else if(it.t==='d')th=Math.min(100,th+it.v);else if(it.t==='e')en=Math.min(maxEn(),en+it.v);
    toast(it.n+' digunakan');qAdd('use');
  }
  save();inv();
}
function delIt(id){S.inv[id]--;if(S.inv[id]<=0){delete S.inv[id];var t=ITEMS[id].t;if(SLOT[t]&&S.eq[t]===id){S.eq[t]=null;applyGear()}}toast('Item dihapus');save();inv()}
function shop(tbn){
  if(tbn)shopTab=tbn;mode='ui';setRun(false);
  var tabs=[['g','Perlengkapan'],['w','Senjata'],['c','Pakaian'],['f','Makanan']],h='<div class="tabs">';
  tabs.forEach(function(t){h+='<button class="tb'+(t[0]===shopTab?' on':'')+'" onclick="shop(\''+t[0]+'\')">'+t[1]+'</button>'});h+='</div>';
  for(var id in ITEMS){var it=ITEMS[id];if(it.k!==shopTab)continue;var have=S.inv[id]||0;
    h+='<div class="row"><div class="gr"><b>'+it.n+'</b><small>'+it.d+(have?' · punya '+have:'')+'</small></div><button class="bt sm pr" onclick="buy(\''+id+'\')">'+price(id)+cur(id)+'</button>'+
    (have?'<button class="bt sm" onclick="sell(\''+id+'\')">Jual '+Math.max(1,Math.floor(price(id)/2))+cur(id)+'</button>':'')+'</div>'}
  ov('<div class="pn"><div class="hd"><h2>Toko</h2><span>💰 '+S.money+' &nbsp;🪙 '+S.coins+'</span></div>'+h+'<button class="bt" onclick="resume()">Tutup</button></div>');
}
function buy(id){
  var it=ITEMS[id],pr=price(id),f=it.p?'money':'coins';
  if(S[f]<pr){toast(it.p?'Uang tidak cukup!':'Coin tidak cukup!',1);return}
  S[f]-=pr;S.inv[id]=(S.inv[id]||0)+1;toast('Berhasil membeli '+it.n);save();shop();
}
function sell(id){
  var it=ITEMS[id],f=it.p?'money':'coins';if(!S.inv[id])return;
  S[f]+=Math.max(1,Math.floor(price(id)/2));S.inv[id]--;
  if(S.inv[id]<=0){delete S.inv[id];if(SLOT[it.t]&&S.eq[it.t]===id){S.eq[it.t]=null;applyGear()}}
  toast('Terjual: '+it.n);save();shop();
}
function die(){
  mode='over';setRun(false);jid=cid=-1;jx=jy=0;
  ov('<div class="pn" style="text-align:center"><div class="lg" style="color:#d9473f;font-size:34px">ANDA TEWAS</div><p class="mu">Level '+S.level+' · Uang '+S.money+' · Coin '+S.coins+'<br>Kamu kehilangan 20% uang saat restart.</p>'+
  '<button class="bt pr" onclick="retry()">Coba Lagi</button><button class="bt" onclick="menu()">Menu Utama</button></div>');
}
function retry(){S.money=Math.floor(S.money*.8);save();initRun();resume()}

/* ===== LOOP ===== */
var last=performance.now();
function loop(now){
  requestAnimationFrame(loop);
  var dt=Math.min((now-last)/1000,.05);last=now;
  if(mode==='play'){
    dayT+=dt/240;play(dt);env(P.x,P.z);
    hT+=dt;if(hT>.1){hT=0;hud()}
  }else if(mode==='menu'){
    dayT+=dt/240;var a=now*.00008;
    cam.position.set(Math.cos(a)*45,14,Math.sin(a)*45);cam.lookAt(0,4,0);env(0,0);
  }
  R.render(sc,cam);
}
loadSet();applySet();menu();requestAnimationFrame(loop);
</script>
